# =============================================================================
# .env.example — «۴ دیواری»
#
# نکته مهم: نسخه فعلی پروژه (این خروجی) صرفاً یک Frontend استاتیک است و
# هیچ‌کدام از این متغیرها را واقعاً نمی‌خواند یا استفاده نمی‌کند — هیچ Backend
# یا سرویس خارجی‌ای هنوز به کد وصل نشده. این فایل صرفاً نقشه‌ی متغیرهایی است
# که هنگام ساخت Backend واقعی (مرحله بعدی پروژه) به آن‌ها نیاز خواهید داشت.
# هیچ مقدار واقعی/محرمانه‌ای اینجا قرار نگرفته است.
# =============================================================================

# --- تنظیمات عمومی سرور Backend (هنوز ساخته نشده) ---
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:8080

# --- پایگاه داده (پیشنهادی: PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/khaneh_be_khaneh
DB_HOST=localhost
DB_PORT=5432
DB_NAME=khaneh_be_khaneh
DB_USER=
DB_PASSWORD=

# --- احراز هویت (JWT برای ورود کاربران و اپراتور) ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
OPERATOR_DEFAULT_PASSWORD=

# --- پیامک / OTP (برای ورود با شماره موبایل و اعلان تایید/رد آگهی) ---
# نمونه ارائه‌دهنده‌های داخلی رایج: کاوه‌نگار (Kavenegar)، قاصدک (Ghasedak)، ملی‌پیامک
SMS_PROVIDER=kavenegar
SMS_API_KEY=
SMS_SENDER_NUMBER=

# --- ذخیره‌سازی فایل/عکس (مدارک هویتی، اسناد ملک، عکس‌های آگهی) ---
# گزینه‌ها: local (دیسک سرور) یا S3-compatible (مثل Arvan Object Storage, Liara Object Storage, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# --- درگاه پرداخت (برای دریافت حق انتشار آگهی) ---
# نمونه درگاه‌های رایج ایرانی: زرین‌پال (ZarinPal)، آیدی‌پی (IDPay)، نکست‌پی
PAYMENT_PROVIDER=zarinpal
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=

# --- نقشه (برای تب «نقشه» و نمایش نزدیک‌ترین آگهی‌ها) ---
# در نسخه فعلی از لینک مستقیم Google Maps/Earth استفاده می‌شود (بدون کلید API).
# در صورت استفاده از نقشه تعاملی (مثل نشان یا Mapbox)، کلید را اینجا اضافه کنید.
MAP_PROVIDER=
MAP_API_KEY=

# --- سامانه کاتب (ثبت رسمی قولنامه) ---
# مطابق توضیحات پروژه، این سامانه فقط برای دفاتر اسناد رسمی/مشاورین املاک دارای
# مجوز در دسترس است و اتصال مستقیم برنامه به آن نیازمند هماهنگی رسمی است؛
# این پروژه فعلاً فقط یک لینک به kateb.ir نمایش می‌دهد.
KATEB_INTEGRATION_ENABLED=false

# --- ایمیل (برای اعلان‌های اپراتور/پشتیبانی، اختیاری) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUPPORT_EMAIL=info@khanehbekhaneh.ir
